{
  "name": "personalidad-mbti",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @personalidad/web --filter @personalidad/api dev",
    "build": "pnpm --filter @personalidad/core run build && pnpm --filter @personalidad/api run build && pnpm --filter @personalidad/web run build",
    "start": "pnpm --filter @personalidad/api start",
    "typecheck": "pnpm -r --parallel run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "hono": "^4.13.5"
  }
}
