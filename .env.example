# ==============================================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE EN VERCEL Y DESARROLLO LOCAL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos: Firebase Firestore (Recomendado para Vercel)
# ------------------------------------------------------------------------------
# Opción A: JSON completo de tu Service Account de Firebase (La más fácil en Vercel):
# Ve a Firebase Console > Configuración del Proyecto > Cuentas de servicio > Generar nueva clave privada.
# Pega todo el contenido del JSON en una sola variable:
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}'

# Opción B: Variables individuales de Firebase:
# FIREBASE_PROJECT_ID=tu-proyecto-firebase
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. Base de Datos: SQL (Opcional si usas PostgreSQL en lugar de Firebase)
# ------------------------------------------------------------------------------
# DB_DRIVER: auto | firebase | postgres | sqlite
DB_DRIVER=auto
PGHOST=localhost
PGPORT=5432
PGDATABASE=personalidad
PGUSER=postgres
PGPASSWORD=postgres
SQLITE_PATH=./personalidad.sqlite

# ------------------------------------------------------------------------------
# 3. Seguridad y Credenciales del Sistema
# ------------------------------------------------------------------------------
# Secreto JWT para firmar tokens de sesión de administradores (usa una cadena larga y segura en producción)
JWT_SECRET=tu-clave-secreta-jwt-super-segura-para-produccion

# Credenciales iniciales del administrador creadas automáticamente en el primer inicio:
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Origen permitido para CORS (en Vercel puede ser tu dominio o http://localhost:5173 en local)
CORS_ORIGIN=http://localhost:5173
PORT=8787
